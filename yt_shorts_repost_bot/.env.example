# ==============================================================================
# Shorts Repost Bot - Environment Configuration (.env)
# Copy this file to '.env' and fill in your settings.
# ==============================================================================

# --- TARGET CHANNELS (whose Shorts do you want to repost?) ---
# Comma-separated channel URLs. The bot grabs their newest Shorts and
# uploads them to YOUR channel.
TARGET_CHANNELS="https://www.youtube.com/@Speedzyshorts,https://www.youtube.com/@deagzzzshorts"
# How many newest Shorts to inspect per channel per cycle
FETCH_LIMIT_PER_CHANNEL=20
# Max Shorts to repost from ONE channel per cycle (total still capped by MAX_DAILY_UPLOADS)
MAX_SHORTS_PER_CHANNEL_CYCLE=2
# Anything longer than this is NOT a Short and gets skipped
MAX_SHORT_DURATION_SEC=60

# --- PROCESSING MODE ---
# "copy"   = re-encode to a clean mp4, keep the Short's original look (fast, default)
# "render" = transcribe + burn viral subtitles + add BGM (slower)
PROCESS_MODE="copy"

# --- RENDER MODE OPTIONS (ignored in copy mode) ---
SHORT_ASPECT="9:16"     # "9:16" classic Shorts, or "3:4" like reference edits
FILL_MODE="blur"        # "blur" = nothing cut | "crop" = center crop
VIDEO_CRF=18            # lower = better quality
VIDEO_PRESET="medium"
AUDIO_BITRATE="192k"
SUBTITLE_STYLE_MODE="viral"
SUBTITLE_FONT_NAME="Arial"
SUBTITLE_FONT_SIZE=28
BGM_ENABLED="true"
BGM_VOLUME=0.18
VOICE_VOLUME=1.00

# --- LOGO / WATERMARK REMOVAL (render mode) ---
LOGO_REMOVE_ENABLED="false"
LOGO_POSITION="top-right"
LOGO_SIZE_PCT=12

# --- KEEP LOCAL COPIES ---
KEEP_LOCAL_SHORTS="true"
KEEP_SHORTS_DIR="finished_shorts"

# --- YOUTUBE COOKIES (fixes "Sign in to confirm you're not a bot") ---
# Export cookies.txt with the "Get cookies.txt LOCALLY" extension while logged
# into YouTube, drop it in this folder, and set the line below.
YT_COOKIES_FILE=""
YT_COOKIES_FROM_BROWSER=""

# --- CLOUDFLARE R2 (OPTIONAL backup storage - leave placeholders for dry-run) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="youtube-shorts-reposts"
R2_ENDPOINT_URL=""
R2_MAX_BUCKET_BYTES=8589934592

# --- YOUTUBE DATA API V3 ---
# Put your client_secret.json from Google Cloud Console into THIS folder.
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token.json"
MAX_DAILY_UPLOADS=10

# --- SCHEDULER & WEB UI ---
CYCLE_INTERVAL_HOURS=3
WEBUI_HOST="0.0.0.0"
WEBUI_PORT=5100
TEMP_DIR="temp_clips"
DB_PATH="bot_state.db"
LOG_FILE="shorts_repost.log"

# --- MULTI-ACCOUNT ---
# For multiple YouTube channels, create accounts.json in this folder
# (see accounts.example.json). Each account gets its own credentials,
# source channels, style settings, and 24h upload quota. Leave this
# section empty to use the single default account from the settings above.

# --- "LIKE & SUBSCRIBE" BOTTOM BANNER ---
LIKE_AND_SUBSCRIBE_ENABLED="true"
LIKE_AND_SUBSCRIBE_TEXT="LIKE & SUBSCRIBE"

# --- TOP CHANNEL WATERMARK (light, upper blur band) ---
# Subtle semi-transparent channel name at the top. Set TOP_WATERMARK_TEXT to
# your channel name (leave empty to disable). Per-account override available
# via accounts.json: "top_watermark" / "top_watermark_enabled".
TOP_WATERMARK_ENABLED="true"
TOP_WATERMARK_TEXT=""


# --- TITLE & HASHTAGS ---
# Hashtags: ONLY what you type in each account's "Title hashtags" setting
# in the control panel (Settings -> Title hashtags). Empty field = NO hashtags.
# The bot never adds auto/reach/content hashtags. TITLE_PREFIX is the global
# default prefix (per-account "Title prefix" overrides it; empty = no prefix).
TITLE_PREFIX=""


# --- VIDEO SELECTION ORDER ---
# Which videos to pick from each source channel:
#   "newest" = most recent first (default) | "oldest" = oldest first | "random"
# The bot never posts the same video twice to the same account.
SELECTION_ORDER="newest"


# --- UPLOAD PACING (per-account in the Settings panel) ---
# min_minutes_between_uploads in each account = minimum gap between uploads
# (0 = as fast as possible, 60 = one per hour). Set it in Settings -> Account settings.


# --- DELETE AFTER UPLOAD (per-account toggle in Settings) ---
DELETE_AFTER_UPLOAD="false"
DELETE_R2_AFTER_UPLOAD="false"


# --- WATERMARK STYLE ---
# Top: soft pink/mauve like the reference (ffmpeg &HAABBGGRR for rgb 190,143,167)
TOP_WATERMARK_COLOR="0xA78FBE"
TOP_WATERMARK_OPACITY=0.9
# Bottom: darker, more visible
BOTTOM_BANNER_BG_OPACITY=0.8
BOTTOM_BANNER_TEXT_SIZE=1.15


# --- TOP WATERMARK: solid green band + white text (like your reference) ---
TOP_WATERMARK_COLOR="0x80B895"   # green rgb(149,184,128)
TOP_WATERMARK_OPACITY=1.0        # 1.0 = solid band
TOP_WATERMARK_BAND="true"        # true = solid band across top, false = text only


# --- WATERMARK STYLE: plain text only ---
# Top: Arial 28, 50% visible, no background
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=28
# Bottom: Arial 28, 100% visible, no background
BOTTOM_BANNER_FONT_SIZE=28
BOTTOM_BANNER_OPACITY=1.0


# --- WATERMARK STYLE: bigger + italic ---
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=40
TOP_WATERMARK_ITALIC="true"
BOTTOM_BANNER_FONT_SIZE=40
BOTTOM_BANNER_OPACITY=1.0
BOTTOM_BANNER_ITALIC="true"


# --- WATERMARK POSITION ---
TOP_WATERMARK_Y_PCT=12    # 12 = inside the TOP blur band (horizontally centered)
BOTTOM_BANNER_Y_PCT=90    # 90 = near bottom
