# ==============================================================================
# YouTube Shorts 24/7 Automation Bot - Environment Configuration Template (.env)
# Copy this file to '.env' and fill in your credentials and target settings.
# ==============================================================================

# --- TARGET SELECTION ---
# Comma-separated list of target YouTube channel URLs or Channel IDs
TARGET_CHANNELS="https://www.youtube.com/@TEDEd,https://www.youtube.com/@Kurzgesagt"
FETCH_LIMIT_PER_CHANNEL=5

# --- HEATMAP & CLIP SETTINGS ---
# Duration of the extracted peak-engagement segment (15 to 20 seconds)
CLIP_DURATION_SEC=18.0
HEATMAP_SMOOTH_WINDOW_SEC=18.0

# --- VIDEO EDITING & SUBTITLES ---
# Faster-Whisper model size (tiny.en, base.en, small). Runs 100% free locally on CPU.
WHISPER_MODEL_SIZE="tiny.en"
MAX_WORDS_PER_SUBTITLE_LINE=4

# FFmpeg Subtitle Styling (TikTok / Shorts Aesthetic)
# Windows users: "Arial" is pre-installed on Windows.
# Linux users:   "DejaVu Sans" is pre-installed on most distros.
SUBTITLE_FONT_NAME="Arial"
SUBTITLE_FONT_SIZE=22

# --- VIRAL SUBTITLE STYLE (like the LA Knight / Speed Short you showed me) ---
# "viral" = 1-2 UPPERCASE words per caption, timed word-by-word (TikTok/Shorts style)
# "standard" = 3-4 words per line
SUBTITLE_STYLE_MODE="viral"
VIRAL_WORDS_PER_LINE=2
SUBTITLE_UPPERCASE="true"

# --- BACKGROUND MUSIC (like the beat in the LA Knight Short) ---
# Drop your .mp3/.wav files into yt_shorts_bot/bgm/ - the bot picks one at random
# BGM_VOLUME = music loudness (0.18 = 18%, quiet under the voice)
# VOICE_VOLUME = original audio loudness (1.0 = 100%)
BGM_ENABLED="true"
BGM_VOLUME=0.18
VOICE_VOLUME=1.00
BGM_DIR="bgm"

# --- CLOUD STORAGE (CLOUDFLARE R2 / S3-COMPATIBLE) ---
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="youtube-shorts-clips"
# Optional custom endpoint (auto-generated from Account ID if blank)
R2_ENDPOINT_URL="https://your_cloudflare_account_id_here.r2.cloudflarestorage.com"

# Maximum Cloudflare R2 bucket usage in bytes before auto-deleting oldest clips
# Default is 8 GB (8589934592 bytes), comfortably within Cloudflare's 10 GB Free Tier
R2_MAX_BUCKET_BYTES=8589934592

# --- YOUTUBE DATA API V3 SETTINGS ---
# Path to your OAuth 2.0 client secrets file downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token.json"

# --- SCHEDULER & HOSTING SETTINGS ---
# Interval in hours between automated channel check cycles
CYCLE_INTERVAL_HOURS=2
TEMP_DIR="temp_clips"
DB_PATH="bot_state.db"
LOG_FILE="shorts_bot.log"

# --- WEB CONTROL PANEL ---
WEBUI_HOST="0.0.0.0"
WEBUI_PORT=5000

# --- FFMPEG (optional - leave empty to auto-detect) ---
# The bot looks for FFmpeg in this order:
#   1. These paths, if set
#   2. A bundled copy in yt_shorts_bot/ffmpeg/bin/ (setup.bat downloads it on Windows)
#   3. Whatever is on your system PATH
# Only set these if you keep FFmpeg somewhere unusual.
FFMPEG_PATH=""
FFPROBE_PATH=""

# --- YOUTUBE COOKIES (fixes "Sign in to confirm you're not a bot") ---
# Option 1: path to a cookies.txt exported from your browser (Netscape format).
#           Get it with the "Get cookies.txt LOCALLY" browser extension,
#           then:  chrome://extensions -> getcookies.txt -> open youtube.com
#           -> click the extension -> Export. Drop the file in yt_shorts_bot/.
YT_COOKIES_FILE="cookies.txt"
# Option 2: read cookies straight from an installed browser.
#           Options: "chrome", "edge", "firefox", "opera", "brave"
#           NOTE: Chrome/Edge must be fully CLOSED for this to work.
YT_COOKIES_FROM_BROWSER=""

# --- KEEP LOCAL COPIES OF FINISHED SHORTS ---
# Set to "true" to keep every finished Short in the finished_shorts/ folder
# (the bot otherwise deletes working files after uploading).
KEEP_LOCAL_SHORTS="true"
KEEP_SHORTS_DIR="finished_shorts"

# --- SHORTS PER VIDEO (auto cycles) ---
# How many Shorts to make from each new video:
#   1 = only the single best moment (heatmap peak / audio-energy peak)
#   2-5 = the top N non-overlapping best moments
SHORTS_PER_VIDEO=1

# --- OUTPUT CANVAS & QUALITY ---
# Aspect ratio of the finished Short:
#   "3:4"  = 1080x1440 (like the reference Shorts you showed me - deagzzzshorts style)
#   "9:16" = 1080x1920 (classic Shorts)
SHORT_ASPECT="3:4"
# How to fit the source video into the canvas:
#   "blur" = whole frame visible, blurred background fills the rest (nothing is cut)
#   "crop" = center-crop to fill the canvas (edges are cut)
FILL_MODE="blur"
# Encoding quality: CRF 18 ~ visually lossless. Lower = better (and bigger file).
VIDEO_CRF=18
VIDEO_PRESET="medium"
AUDIO_BITRATE="192k"

# --- LOGO / WATERMARK REMOVAL (beta) ---
# Blurs a corner logo/watermark (e.g. streamer overlays) so it does not appear
# in the Short. "false" = only when you pick it in the control panel.
LOGO_REMOVE_ENABLED="false"
LOGO_POSITION="top-right"
LOGO_SIZE_PCT=12

# --- DAILY UPLOAD LIMIT ---
# YouTube Data API quota: ~10,000 units/day, 1 upload ~= 1,600 units (≈6/day).
# Many accounts can push 10/day. If you set this higher, the bot will ATTEMPT
# more - YouTube rejects anything over its quota (you'll see quota errors).
MAX_DAILY_UPLOADS=10

# --- MULTI-ACCOUNT ---
# For multiple YouTube channels, create accounts.json in this folder
# (see accounts.example.json). Each account gets its own credentials,
# source channels, style settings, and 24h upload quota. Leave this
# section empty to use the single default account from the settings above.

# --- "LIKE & SUBSCRIBE" BOTTOM BANNER ---
LIKE_AND_SUBSCRIBE_ENABLED="true"
LIKE_AND_SUBSCRIBE_TEXT="LIKE & SUBSCRIBE"

# --- TOP CHANNEL WATERMARK (light, upper blur band) ---
# Subtle semi-transparent channel name at the top. Set TOP_WATERMARK_TEXT to
# your channel name (leave empty to disable). Per-account override available
# via accounts.json: "top_watermark" / "top_watermark_enabled".
TOP_WATERMARK_ENABLED="true"
TOP_WATERMARK_TEXT=""


# --- VIDEO SELECTION ORDER ---
# Which videos to pick from each source channel:
#   "newest" = most recent first (default) | "oldest" = oldest first | "random"
# The bot never posts the same video twice to the same account.
SELECTION_ORDER="newest"


# --- UPLOAD PACING (per-account in the Settings panel) ---
# min_minutes_between_uploads in each account = minimum gap between uploads
# (0 = as fast as possible, 60 = one per hour). Set it in Settings -> Account settings.


# --- DELETE AFTER UPLOAD (per-account toggle in Settings) ---
DELETE_AFTER_UPLOAD="false"
DELETE_R2_AFTER_UPLOAD="false"


# --- WATERMARK STYLE ---
# Top: soft pink/mauve like the reference (ffmpeg &HAABBGGRR for rgb 190,143,167)
TOP_WATERMARK_COLOR="0xA78FBE"
TOP_WATERMARK_OPACITY=0.9
# Bottom: darker, more visible
BOTTOM_BANNER_BG_OPACITY=0.8
BOTTOM_BANNER_TEXT_SIZE=1.15


# --- TOP WATERMARK: solid green band + white text (like your reference) ---
TOP_WATERMARK_COLOR="0x80B895"   # green rgb(149,184,128)
TOP_WATERMARK_OPACITY=1.0        # 1.0 = solid band
TOP_WATERMARK_BAND="true"        # true = solid band across top, false = text only


# --- WATERMARK STYLE: plain text only ---
# Top: Arial 28, 50% visible, no background
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=28
# Bottom: Arial 28, 100% visible, no background
BOTTOM_BANNER_FONT_SIZE=28
BOTTOM_BANNER_OPACITY=1.0


# --- WATERMARK STYLE: bigger + italic ---
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=40
TOP_WATERMARK_ITALIC="true"
BOTTOM_BANNER_FONT_SIZE=40
BOTTOM_BANNER_OPACITY=1.0
BOTTOM_BANNER_ITALIC="true"


# --- WATERMARK POSITION ---
TOP_WATERMARK_Y_PCT=12    # 12 = inside the TOP blur band (horizontally centered)
BOTTOM_BANNER_Y_PCT=90    # 90 = near bottom
