# YouTube clip-farming bot configuration
# Copy to .env. Never commit .env, OAuth files, cookies, tokens, logs, or DBs.

# Source discovery (used only by legacy single-account mode; named accounts use accounts.json)
TARGET_CHANNELS=""
FETCH_LIMIT_PER_CHANNEL=5
CLIP_DURATION_SEC=18
HEATMAP_SMOOTH_WINDOW_SEC=18
SHORTS_PER_VIDEO=1
SELECTION_ORDER="newest"

# Rendering
SHORT_ASPECT="3:4"
FILL_MODE="blur"
VIDEO_CRF=18
VIDEO_PRESET="medium"
AUDIO_BITRATE="192k"
FFMPEG_TIMEOUT_SEC=900
FFMPEG_PATH=""
FFPROBE_PATH=""

# Captions
WHISPER_MODEL_SIZE="tiny.en"
WHISPER_LANGUAGE="auto"
MAX_WORDS_PER_SUBTITLE_LINE=4
SUBTITLE_STYLE_MODE="viral"
VIRAL_WORDS_PER_LINE=2
SUBTITLE_UPPERCASE=true
SUBTITLE_FONT_NAME=""
SUBTITLE_FONT_SIZE=28

# Optional background music
BGM_ENABLED=true
BGM_VOLUME=0.18
VOICE_VOLUME=1.0
BGM_DIR="bgm"

# Optional source-logo blur
LOGO_REMOVE_ENABLED=false
LOGO_POSITION="top-right"
LOGO_SIZE_PCT=12

# Account text overlays
LIKE_AND_SUBSCRIBE_ENABLED=true
LIKE_AND_SUBSCRIBE_TEXT="LIKE & SUBSCRIBE"
TOP_WATERMARK_ENABLED=true
TOP_WATERMARK_TEXT=""
TOP_WATERMARK_COLOR="white"
TOP_WATERMARK_OPACITY=0.5
TOP_WATERMARK_FONT_SIZE=56
TOP_WATERMARK_ITALIC=true
TOP_WATERMARK_Y_PCT=12
BOTTOM_BANNER_FONT_SIZE=56
BOTTOM_BANNER_OPACITY=1.0
BOTTOM_BANNER_ITALIC=true
BOTTOM_BANNER_Y_PCT=90

# Optional Cloudflare R2 backup. Leave blank to skip R2 without simulating success.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="youtube-shorts-clips"
R2_ENDPOINT_URL=""
R2_MAX_BUCKET_BYTES=8589934592

# Legacy single-account OAuth paths. Named accounts use accounts/<safe-name>/.
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token.json"
MAX_DAILY_UPLOADS=10
# Explicit preview mode: prepares files but never records a YouTube upload/quota.
DRY_RUN=false

# Scheduler and retention
CYCLE_INTERVAL_HOURS=2
MIN_MINUTES_BETWEEN_UPLOADS=0
KEEP_LOCAL_SHORTS=true
KEEP_SHORTS_DIR="finished_shorts"
DELETE_AFTER_UPLOAD=false
DELETE_R2_AFTER_UPLOAD=false

# YouTube download authentication (optional)
YT_COOKIES_FILE=""
YT_COOKIES_FROM_BROWSER=""

# Paths
TEMP_DIR="temp_clips"
DB_PATH="bot_state.db"
LOG_FILE="shorts_bot.log"

# Web UI: local-only by default. A non-loopback bind requires WEBUI_PASSWORD.
WEBUI_HOST="127.0.0.1"
WEBUI_PORT=5000
WEBUI_USERNAME="admin"
WEBUI_PASSWORD=""
WEBUI_SECRET_KEY=""
WEBUI_COOKIE_SECURE=false

# Metadata compatibility settings. Published hashtags remain user-controlled.
ENABLE_SMART_TITLES=false
MAX_TITLE_HASHTAGS=4
REACH_HASHTAGS=""
EXTRA_HASHTAGS=""
TITLE_PREFIX=""
